# Leave DATABASE_URL empty for guest-only local development. When it is set,
# every other server-side auth value below is required.
DATABASE_URL=
BETTER_AUTH_URL=http://127.0.0.1:8080
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
RESEND_API_KEY=
AUTH_EMAIL_FROM=Hidden <no-reply@philippeho.dev>
TURNSTILE_SECRET_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY_HOPS=

# Public build-time value. Production Docker builds fail when this is absent.
VITE_TURNSTILE_SITE_KEY=

